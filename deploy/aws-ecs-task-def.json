{
  "family": "placement-tracker-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "ACCOUNT_ID.dkr.ecr.AWS_REGION.amazonaws.com/placement-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PROJECT_NAME", "value": "Placement Preparation & Job Tracker" },
        { "name": "ACCESS_TOKEN_EXPIRE_MINUTES", "value": "1440" },
        { "name": "CORS_ORIGINS", "value": "[\"https://placement-tracker.yourdomain.com\"]" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:placement/db_url"
        },
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:placement/jwt_secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/placement-tracker-backend",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "backend"
        }
      }
    },
    {
      "name": "frontend",
      "image": "ACCOUNT_ID.dkr.ecr.AWS_REGION.amazonaws.com/placement-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "VITE_API_URL", "value": "https://api.placement-tracker.yourdomain.com" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/placement-tracker-frontend",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
