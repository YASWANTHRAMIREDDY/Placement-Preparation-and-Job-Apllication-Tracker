PROJECT_NAME="Placement Preparation & Job Application Tracker"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretjwtkey_change_in_production_environment_with_strong_random_value"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database connection (Default in Docker):
# mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://placement_user:placement_pass@localhost:3306/placement_tracker

# For standalone quick testing without MySQL, SQLite can be used:
# DATABASE_URL=sqlite:///./placement_tracker.db

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
